generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}
datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum StatusEmprestimo {
  EMPRESTADO
  DEVOLVIDO
  ATRASADO
}

enum NivelPerfil {
  LEITOR
  BIBLIOTECARIO
  DEV
}

model User {
  id            String         @id @default(auto()) @map("_id") @db.ObjectId
  nome          String
  email         String         @unique
  senha         String
  nivel_perfil  NivelPerfil    @default(LEITOR)
  createdAt     DateTime       @default(now())
  emprestimos   Emprestimo[]
  refreshTokens RefreshToken[]
}

model RefreshToken {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  token     String   @unique
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id])
  expiresAt DateTime
  createdAt DateTime @default(now())
}
//não funcionou do jeito facil bora de gambiarra depois da janta
model Categoria {
  id                 String      @id @default(auto()) @map("_id") @db.ObjectId
  nome               String      @unique
  categoriasBaseIds  String[]    @db.ObjectId
  categoriasBase     Categoria[] @relation("CategoriaSub", fields: [categoriasBaseIds], references: [id])
  subCategoriaIds    String[]    @db.ObjectId
  subCategorias      Categoria[] @relation("CategoriaSub", fields: [subCategoriaIds], references: [id])
  livroIds           String[]    @db.ObjectId
  livros             Livro[]     @relation(fields: [livroIds], references: [id])
  createdAt          DateTime    @default(now())
}

model Livro {
  id           String       @id @default(auto()) @map("_id") @db.ObjectId
  titulo       String
  autor        String
  editora      String
  ano          Int
  disponivel   Boolean      @default(true)
  categoriaIds String[]     @db.ObjectId
  categorias   Categoria[]  @relation(fields: [categoriaIds], references: [id])
  emprestimos  Emprestimo[]
  createdAt    DateTime     @default(now())
}

model Emprestimo {
  id             String           @id @default(auto()) @map("_id") @db.ObjectId
  usuarioId      String           @db.ObjectId
  usuario        User             @relation(fields: [usuarioId], references: [id])
  livroId        String           @db.ObjectId
  livro          Livro            @relation(fields: [livroId], references: [id])
  dataEmprestimo DateTime         @default(now())
  dataPrevista   DateTime
  dataDevolucao  DateTime?
  status         StatusEmprestimo @default(EMPRESTADO)
}