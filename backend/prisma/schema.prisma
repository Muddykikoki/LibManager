generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}
// sei la porque ta vermelho mas ta funcionando
datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum StatusEmprestimo {
  EMPRESTADO
  DEVOLVIDO
  ATRASADO
}

enum NivelPerfil {
  LEITOR
  BIBLIOTECARIO
  DEV
}

model User {
  id            String         @id @default(auto()) @map("_id") @db.ObjectId
  nome          String
  email         String         @unique
  senha         String
  nivel_perfil  NivelPerfil    @default(LEITOR)
  createdAt     DateTime       @default(now())
  emprestimos   Emprestimo[]
  refreshTokens RefreshToken[]
}

model RefreshToken {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  token     String   @unique
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id])
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Categoria {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  nome      String
  livros    Livro[]
  createdAt DateTime @default(now())
}

model Livro {
  id          String       @id @default(auto()) @map("_id") @db.ObjectId
  titulo      String
  autor       String
  editora     String
  ano         Int
  disponivel  Boolean      @default(true)
  categoriaId String       @db.ObjectId
  categoria   Categoria    @relation(fields: [categoriaId], references: [id])
  emprestimos Emprestimo[]
  createdAt   DateTime     @default(now())
}

model Emprestimo {
  id             String           @id @default(auto()) @map("_id") @db.ObjectId
  usuarioId      String           @db.ObjectId
  usuario        User             @relation(fields: [usuarioId], references: [id])
  livroId        String           @db.ObjectId
  livro          Livro            @relation(fields: [livroId], references: [id])
  dataEmprestimo DateTime         @default(now())
  dataPrevista   DateTime
  dataDevolucao  DateTime?
  status         StatusEmprestimo @default(EMPRESTADO)
}