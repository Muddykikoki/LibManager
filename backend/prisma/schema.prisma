generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}
datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum StatusEmprestimo {
  EMPRESTADO
  DEVOLVIDO
  ATRASADO
}

enum NivelPerfil {
  LEITOR
  BIBLIOTECARIO
  DEV
}

enum EstadoExemplar {
  NOVO
  OTIMO
  BOM
  USADO
}

model User {
  id            String         @id @default(auto()) @map("_id") @db.ObjectId
  nome          String
  email         String         @unique
  senha         String
  nivel_perfil  NivelPerfil    @default(LEITOR)
  createdAt     DateTime       @default(now())
  moedas        Int            @default(0)
  compras       Compra[]
  emprestimos   Emprestimo[]
  refreshTokens RefreshToken[]
}

model RefreshToken {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  token     String   @unique
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id])
  expiresAt DateTime
  createdAt DateTime @default(now())
}
model Categoria {
  id                 String      @id @default(auto()) @map("_id") @db.ObjectId
  nome               String      @unique
  categoriasBaseIds  String[]    @db.ObjectId
  categoriasBase     Categoria[] @relation("CategoriaSub", fields: [categoriasBaseIds], references: [id])
  subCategoriaIds    String[]    @db.ObjectId
  subCategorias      Categoria[] @relation("CategoriaSub", fields: [subCategoriaIds], references: [id])
  livroIds           String[]    @db.ObjectId
  livros             Livro[]     @relation(fields: [livroIds], references: [id])
  createdAt          DateTime    @default(now())
}

model Livro {
  id           String       @id @default(auto()) @map("_id") @db.ObjectId
  titulo       String
  autor        String
  editora      String
  ano          Int
  disponivel   Boolean      @default(true)
  descricao    String       
  preco        Float        @default(0)
  examplares   Exemplar[]
  categoriaIds String[]     @db.ObjectId
  categorias   Categoria[]  @relation(fields: [categoriaIds], references: [id])
  // emprestimos  Emprestimo[]
  createdAt    DateTime     @default(now())
}

model Emprestimo {
  id             String           @id @default(auto()) @map("_id") @db.ObjectId
  usuarioId      String           @db.ObjectId
  usuario        User             @relation(fields: [usuarioId], references: [id])
  exemplarId     String           @db.ObjectId
  exemplar       Exemplar         @relation(fields: [exemplarId], references: [id])
  dataEmprestimo DateTime         @default(now())
  dataPrevista   DateTime
  dataDevolucao  DateTime?
  moedasGanhas   Int              @default(0)
  status         StatusEmprestimo @default(EMPRESTADO)
}

model Exemplar {
  id          String         @id @default(auto()) @map("_id") @db.ObjectId
  livroId     String         @db.ObjectId
  livro       Livro          @relation(fields: [livroId], references: [id])
  estado      EstadoExemplar @default(NOVO)
  disponivel  Boolean        @default(true)
  vendido     Boolean        @default(false)
  emprestimos Emprestimo[]
  compras     Compra[]
  createdAt   DateTime       @default(now())
}

model Compra {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  userId      String   @db.ObjectId
  user        User     @relation(fields: [userId], references: [id])
  exemplarId  String   @db.ObjectId
  exemplar    Exemplar @relation(fields: [exemplarId], references: [id])
  precoPago   Float
  pagoMoedas  Boolean  @default(false)
  createdAt   DateTime @default(now())
}